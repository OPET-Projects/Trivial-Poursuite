# Modèle interrogé, identifiant tel qu'affiché par LM Studio.
# La matrice compare google/gemma-3-12b, liquid/lfm2-24b-a2b,
# google/gemma-4-26b-a4b-qat et prism-ml/bonsai-27b : lancer l'étage enrich
# une fois par modèle, via --model.
LLM_MODEL=google/gemma-4-26b-a4b-qat

# Modèle utilisé pour arbitrer les réponses ambiguës. Par défaut, LLM_MODEL.
# JUDGE_MODEL=google/gemma-4-26b-a4b-qat

# Adresse du serveur LM Studio
# LMSTUDIO_BASE_URL=http://localhost:1234

# Délai maximum d'un appel LLM, en secondes
# LLM_TIMEOUT_SECONDS=180

# Raisonnement des modèles qui en ont un. "none" garde le protocole commun à
# tous les runs mesurés ; toute autre valeur les rend incomparables.
# LLM_REASONING_EFFORT=none
