# Modèle interrogé, identifiant tel qu'affiché par LM Studio.
# La matrice compare google/gemma-3-12b et liquid/lfm2-24b-a2b : lancer
# l'étage enrich une fois par modèle, via --model.
LLM_MODEL=google/gemma-3-12b

# Modèle utilisé pour arbitrer les réponses ambiguës. Par défaut, LLM_MODEL.
# JUDGE_MODEL=google/gemma-3-12b

# Délai maximum d'un appel LLM, en secondes
# LLM_TIMEOUT_SECONDS=180
